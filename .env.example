# Math & Physics Model Library - Environment Variables
# Copy this file to .env.local for local development

PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------
# 1. Supabase Database Configuration (PostgreSQL Metadata)
# ----------------------------------------------------
# Get these from your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ----------------------------------------------------
# 2. Central Admin Google Drive Configuration
# ----------------------------------------------------
# The website uses ONE shared Admin Google Drive for all model storage.
# Normal users do not need to provide Google credentials or authorize Drive.
# Configure these once on the Admin/Server environment:
GOOGLE_CLIENT_ID=your_admin_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_admin_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_admin_google_oauth_refresh_token
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ----------------------------------------------------
# 3. Security & App Secrets
# ----------------------------------------------------
APP_SECRET=your_super_secret_encryption_key_here
